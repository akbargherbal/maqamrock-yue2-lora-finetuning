source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_rank_ema_cot", "label": "Rank, EMA, and cot Quality Rationale", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rank 32 limits capacity spent memorizing per-clip artifacts in a narrow caption space; EMA is a consistency lever; cot off avoids SheetSage2 for captions with no melodic info."}, {"id": "decisions_backup_settle", "label": "Backup Settle Must Ignore loss_log.db", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_goal_correction_window", "label": "Goal Correction: train_window_frames Was the Gap", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whole-song structure goal made the implicit 60s crop a real bug: no AR gradient ever spanned a verse-to-chorus transition; train_window_frames: 0 disables cropping."}, {"id": "decisions_lesson_goal_change", "label": "Lesson: Goal Change Invalidates Old Decisions", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On any goal change, list every artifact encoding the old goal and re-justify it; record deliberate omissions as decisions; test the goal metric during training."}, {"id": "decisions_same_name_autoresume", "label": "Same Run Name Auto-Resumes", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_extend_overwrites_final", "label": "Extending a Run Overwrites Final Adapter", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_l4_vs_a100", "label": "Whole-Song L4 vs A100 Measured", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_cross_vm_resume", "label": "Cross-VM / Cross-GPU Resume", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_caption_lyric_format", "label": "v2 Caption Lyric Format (binding)", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_dataset_naming_convention", "label": "Dataset Naming: Descriptive Suffixes, No Versions", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_trigger_word", "label": "Trigger Word Does Not Double-Prepend", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_run_name_reuse", "label": "Reuse Run Name akbar_arabic_rock_lora", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_heldout_eval_not_clean", "label": "Held-Out Eval Set Contamination", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Held-out status must be judged by lyric-line overlap against the full training set, never by title, workspace, or shortlist membership."}, {"id": "decisions_sample_duration_360", "label": "sample.duration 360 Rationale and Cost", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Samples must carry real held-out lyrics at 360s so a checkpoint can show pronunciation and a full intro-verse-chorus-outro arc; cost scales with generated length."}, {"id": "decisions_agent_training_control", "label": "Agent Training-Control Policy", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_token_count_check", "label": "Token-Count Check: No Overflow", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_v2_finished", "label": "v2 Finished: Lyric Fix Worked; ar_kl Drift", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_t4_vram_attention", "label": "T4 VRAM Governed by Attention Kernel", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On CC 7.5 auto selects eager NAR attention; forcing yue2.attention=flash halves VRAM and passes the OOM point. The earlier \u22645800-frame ceiling claim is retracted."}, {"id": "decisions_inference_manual_commands", "label": "Inference Commands Run Manually; Agent Reads Files", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_audio_cpp_seeds", "label": "audio.cpp Seeds and Sidecar Policy", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use seeds below 2^32; every generated track gets a JSON sidecar; cross-arch re-rendering is a new render, not reproduction \u2014 the WAV is the only guaranteed copy."}, {"id": "decisions_inference_backup_race", "label": "Inference Backup Is a Race Against VM Death", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_batch_verdict_criteria", "label": "Batch Verdict Criteria Fixed Before Generating", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_audiocpp_build", "label": "audio.cpp Build: --model-set full Was the Cost", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "build_linux.sh defaults to --model-set full compiling all families; scope with --model-set custom --models yue2 --cuda-arch 75 --ccache."}, {"id": "decisions_yue2_lora_native", "label": "YuE2 LoRA Loading Native in audio.cpp", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session options load unfused adapters directly; use BF16 main GGUF when a LoRA is loaded because merging into Q8/Q4 dequantizes and requantizes."}, {"id": "decisions_merge_pron_lora", "label": "Merging Two YuE2 LoRAs: Rank-Concat", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Offline file merge (rank concatenation); converter enforces a single rank so NAR is zero-padded at alpha>0; merged file sha256 is nondeterministic, verify by tensor digest or converted hash."}, {"id": "decisions_yue2_cli_flags", "label": "audio.cpp docs/models/yue2.md Is CLI Flag Source of Truth", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_audiocpp_inference_path", "label": "audiocpp_inference Staging Rule", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_command_handover", "label": "Handing Over a Command States Terminal Semantics", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_lora_library", "label": "Canonical LoRA Library <base>/loras/", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One prefix for current deployable adapters; sweep/prototype adapters stay non-canonical. A canonical location is a decision, not an insight."}, {"id": "decisions_listening_gcs", "label": "Generated Listening Packages Live in GCS", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decisions_no_best_before_listen", "label": "No Adapter Is Best Before the Blind Listen; alpha <= 0.5", "file_type": "rationale", "source_file": "DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Describe candidates by parameters and mark them unlistened; never best/primary/shipped until listening decides and the user confirms. alpha is capped at 0.5."}], "ed